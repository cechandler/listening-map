{
  "name": "listening-map",
  "version": "2.0.0",
  "private": true,
  "description": "Listening Map: map the form of recorded music on a timeline, served as a Google Apps Script web app per course",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "test:ui": "node scripts/build.mjs && node tests/ui/run.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
